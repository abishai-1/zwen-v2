# Public site URL (used for metadata, sitemap and canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (Neon / Supabase now, AWS RDS later). Enquiries are stored here.
DATABASE_URL=

# Resend — sends a notification for each enquiry
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=

# Cloudflare Turnstile spam protection (optional; the honeypot is always on)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
